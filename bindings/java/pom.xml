<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>io.github.adrian729</groupId>
  <artifactId>ducktape-provider</artifactId>
  <version>0.1.0</version>
  <packaging>jar</packaging>
  <name>ducktape-provider</name>
  <description>One normalized interface over model vendors</description>
  <url>https://github.com/adrian729/ducktape-provider</url>
  <licenses>
    <license>
      <name>MIT</name>
      <url>https://opensource.org/licenses/MIT</url>
    </license>
  </licenses>
  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <chicory.version>1.7.5</chicory.version>
    <jackson.version>2.22.4</jackson.version>
    <junit.version>6.1.3</junit.version>
  </properties>
  <dependencies>
    <dependency>
      <groupId>com.dylibso.chicory</groupId>
      <artifactId>runtime</artifactId>
      <version>${chicory.version}</version>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>${jackson.version}</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>com.dylibso.chicory</groupId>
        <artifactId>chicory-compiler-maven-plugin</artifactId>
        <version>${chicory.version}</version>
        <executions>
          <execution>
            <id>compile-core</id>
            <goals>
              <goal>compile</goal>
            </goals>
            <configuration>
              <wasmFile>core.wasm</wasmFile>
              <name>io.github.adrian729.ducktape.wasm.CoreModule</name>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.4</version>
        <configuration>
          <environmentVariables>
            <HOME>${project.build.directory}/test-home</HOME>
            <CODEX_HOME>${project.build.directory}/test-home/.codex</CODEX_HOME>
            <ANTHROPIC_CONFIG_DIR>${project.build.directory}/test-home/.config/anthropic</ANTHROPIC_CONFIG_DIR>
            <CLAUDE_CONFIG_DIR>${project.build.directory}/test-home/.claude</CLAUDE_CONFIG_DIR>
          </environmentVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
