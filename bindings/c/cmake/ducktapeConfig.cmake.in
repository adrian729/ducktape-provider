@PACKAGE_INIT@

set_and_check(DUCKTAPE_INCLUDE_DIR "@PACKAGE_CMAKE_INSTALL_INCLUDEDIR@")
set_and_check(DUCKTAPE_LIB_DIR "@PACKAGE_CMAKE_INSTALL_LIBDIR@")

if(NOT TARGET ducktape::ducktape)
  add_library(ducktape::ducktape SHARED IMPORTED)
  set_target_properties(ducktape::ducktape PROPERTIES IMPORTED_LOCATION "${DUCKTAPE_LIB_DIR}/${CMAKE_SHARED_LIBRARY_PREFIX}ducktape_abi${CMAKE_SHARED_LIBRARY_SUFFIX}" INTERFACE_INCLUDE_DIRECTORIES "${DUCKTAPE_INCLUDE_DIR}")
  if(WIN32)
    set_target_properties(ducktape::ducktape PROPERTIES IMPORTED_IMPLIB "${DUCKTAPE_LIB_DIR}/ducktape_abi.dll.lib")
  endif()
endif()

if(NOT TARGET ducktape::ducktape_static AND EXISTS "${DUCKTAPE_LIB_DIR}/${CMAKE_STATIC_LIBRARY_PREFIX}ducktape_abi${CMAKE_STATIC_LIBRARY_SUFFIX}")
  add_library(ducktape::ducktape_static STATIC IMPORTED)
  set_target_properties(ducktape::ducktape_static PROPERTIES IMPORTED_LOCATION "${DUCKTAPE_LIB_DIR}/${CMAKE_STATIC_LIBRARY_PREFIX}ducktape_abi${CMAKE_STATIC_LIBRARY_SUFFIX}" INTERFACE_INCLUDE_DIRECTORIES "${DUCKTAPE_INCLUDE_DIR}" INTERFACE_LINK_LIBRARIES "@DUCKTAPE_SYSTEM_LIBS@")
endif()

check_required_components(ducktape)
