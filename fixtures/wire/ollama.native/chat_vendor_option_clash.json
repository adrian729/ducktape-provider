{
  "name": "chat_vendor_option_clash",
  "source": "synthetic",
  "start": {
    "clock": {
      "now_ms": 0,
      "entropy": "gICAgICAgICAgICAgICAgICAgICAgICAgICAgICAgICAgIA="
    },
    "provider": {
      "ns": "ollama"
    },
    "operation": {
      "type": "chat",
      "request": {
        "model": "qwen3",
        "messages": [
          {
            "role": "user",
            "content": [
              {
                "type": "text",
                "text": "hi"
              }
            ]
          }
        ],
        "options": {
          "max_output_tokens": 10
        },
        "vendor": {
          "ollama": {
            "options": {
              "num_predict": 20
            }
          }
        }
      }
    }
  },
  "secrets": {},
  "http": [],
  "exchange": [
    {
      "step": {
        "effect": {
          "type": "need_secret",
          "secret_ref": "auth:0",
          "source": {
            "type": "env",
            "names": [
              "OLLAMA_API_KEY"
            ],
            "kind": "bearer",
            "placement": "authorization"
          }
        }
      },
      "input": {
        "type": "secret",
        "secret_ref": "auth:0",
        "found": false
      }
    },
    {
      "step": {
        "effect": {
          "type": "failed",
          "error": {
            "kind": "bad_request",
            "message": "vendor field `options.num_predict` clashes with an option that sets the same field",
            "code": "invalid_argument",
            "retryable": false,
            "attempts": 0,
            "origin": {
              "wire": "ollama.native",
              "ns": "ollama",
              "base_url": "http://127.0.0.1:11434",
              "model": "qwen3"
            }
          }
        }
      }
    }
  ]
}
