{
  "name": "chat_strict_fails_on_warning",
  "source": "synthetic",
  "start": {
    "clock": {
      "now_ms": 0,
      "entropy": "gICAgICAgICAgICAgICAgICAgICAgICAgICAgICAgICAgIA="
    },
    "provider": {
      "ns": "google"
    },
    "operation": {
      "type": "chat",
      "request": {
        "model": "gemini-3.8-flash",
        "messages": [
          {
            "role": "user",
            "content": [
              {
                "type": "text",
                "text": "hi"
              }
            ]
          }
        ],
        "options": {
          "parallel_tools": false
        },
        "strict": true
      }
    }
  },
  "secrets": {
    "auth:0": "google-key"
  },
  "http": [],
  "exchange": [
    {
      "step": {
        "effect": {
          "type": "need_secret",
          "secret_ref": "auth:0",
          "source": {
            "type": "env",
            "names": [
              "GEMINI_API_KEY"
            ],
            "kind": "api_key",
            "placement": "x-goog-api-key"
          }
        }
      },
      "input": {
        "type": "secret",
        "secret_ref": "auth:0",
        "found": true
      }
    },
    {
      "step": {
        "effect": {
          "type": "failed",
          "error": {
            "kind": "unsupported",
            "message": "parallel_tools: Google has no parallel tool call toggle",
            "code": "strict",
            "retryable": false,
            "attempts": 0,
            "origin": {
              "wire": "google.interactions",
              "ns": "google",
              "base_url": "https://generativelanguage.googleapis.com",
              "model": "gemini-3.8-flash",
              "auth_source": "env:GEMINI_API_KEY"
            }
          }
        }
      }
    }
  ]
}
