{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/adrian729/ducktape-provider/schema/1.0.0",
  "title": "ducktape provider normalized types",
  "description": "Cross-language contract. Version in $id: minor = additive, major = breaking. Open world: unknown fields are preserved and ignored, enums are open, unknown block and event types decode as custom / raw. Every union carries a discriminator.",
  "$defs": {
    "VendorMap": {
      "type": "object",
      "description": "Vendor-specific passthrough keyed by vendor",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object"
      }
    },
    "CacheMark": {
      "type": "object",
      "properties": {
        "ttl": {
          "anyOf": [
            {
              "enum": [
                "short",
                "long"
              ]
            },
            {
              "type": "string"
            }
          ]
        }
      },
      "description": "Cache breakpoint on a block or tool list"
    },
    "Origin": {
      "type": "object",
      "properties": {
        "wire": {
          "type": "string"
        },
        "vendor": {
          "anyOf": [
            {
              "enum": [
                "anthropic",
                "openai",
                "google",
                "ollama"
              ]
            },
            {
              "type": "string"
            }
          ],
          "description": "Vendor, company name"
        },
        "base_url": {
          "type": "string",
          "format": "uri"
        },
        "model": {
          "type": "string"
        },
        "auth_source": {
          "type": "string",
          "description": "env:NAME, session:PRESET, resolver, inline"
        }
      },
      "required": [
        "wire",
        "vendor",
        "base_url",
        "model"
      ],
      "description": "Where a response or an opaque block came from; opaque state is replayed when wire and base_url match the call"
    },
    "Role": {
      "anyOf": [
        {
          "enum": [
            "user",
            "assistant",
            "system",
            "tool"
          ]
        },
        {
          "type": "string"
        }
      ]
    },
    "TextBlock": {
      "type": "object",
      "properties": {
        "type": {
          "const": "text"
        },
        "id": {
          "type": "string"
        },
        "cache": {
          "$ref": "#/$defs/CacheMark"
        },
        "vendor": {
          "$ref": "#/$defs/VendorMap"
        },
        "provider_executed": {
          "type": "boolean"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "text"
      ]
    },
    "ImageBlock": {
      "type": "object",
      "properties": {
        "type": {
          "const": "image"
        },
        "id": {
          "type": "string"
        },
        "cache": {
          "$ref": "#/$defs/CacheMark"
        },
        "vendor": {
          "$ref": "#/$defs/VendorMap"
        },
        "provider_executed": {
          "type": "boolean"
        },
        "data": {
          "type": "string",
          "contentEncoding": "base64"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "file_id": {
          "type": "string"
        },
        "media_type": {
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "oneOf": [
        {
          "required": [
            "data"
          ]
        },
        {
          "required": [
            "url"
          ]
        },
        {
          "required": [
            "file_id"
          ]
        }
      ]
    },
    "DocumentBlock": {
      "type": "object",
      "properties": {
        "type": {
          "const": "document"
        },
        "id": {
          "type": "string"
        },
        "cache": {
          "$ref": "#/$defs/CacheMark"
        },
        "vendor": {
          "$ref": "#/$defs/VendorMap"
        },
        "provider_executed": {
          "type": "boolean"
        },
        "data": {
          "type": "string",
          "contentEncoding": "base64"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "file_id": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "media_type": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "oneOf": [
        {
          "required": [
            "data"
          ]
        },
        {
          "required": [
            "url"
          ]
        },
        {
          "required": [
            "file_id"
          ]
        },
        {
          "required": [
            "text"
          ]
        }
      ]
    },
    "ToolCallBlock": {
      "type": "object",
      "properties": {
        "type": {
          "const": "tool_call"
        },
        "id": {
          "type": "string"
        },
        "cache": {
          "$ref": "#/$defs/CacheMark"
        },
        "vendor": {
          "$ref": "#/$defs/VendorMap"
        },
        "provider_executed": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "arguments": {
          "type": "object"
        },
        "truncated": {
          "type": "boolean"
        },
        "arguments_json": {
          "type": "string",
          "description": "Raw arguments text when parsing failed or was cut"
        },
        "status": {
          "anyOf": [
            {
              "enum": [
                "pending",
                "in_progress",
                "completed",
                "failed",
                "cancelled"
              ]
            },
            {
              "type": "string"
            }
          ],
          "description": "Reserved for agents"
        }
      },
      "required": [
        "type",
        "id",
        "name",
        "arguments"
      ]
    },
    "ToolResultBlock": {
      "type": "object",
      "properties": {
        "type": {
          "const": "tool_result"
        },
        "id": {
          "type": "string"
        },
        "cache": {
          "$ref": "#/$defs/CacheMark"
        },
        "vendor": {
          "$ref": "#/$defs/VendorMap"
        },
        "provider_executed": {
          "type": "boolean"
        },
        "tool_call_id": {
          "type": "string"
        },
        "content": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Block"
          }
        },
        "is_error": {
          "type": "boolean"
        }
      },
      "required": [
        "type",
        "tool_call_id",
        "content"
      ]
    },
    "ReasoningBlock": {
      "type": "object",
      "properties": {
        "type": {
          "const": "reasoning"
        },
        "id": {
          "type": "string"
        },
        "cache": {
          "$ref": "#/$defs/CacheMark"
        },
        "vendor": {
          "$ref": "#/$defs/VendorMap"
        },
        "provider_executed": {
          "type": "boolean"
        },
        "text": {
          "type": "string"
        },
        "vendor_state": {
          "description": "Opaque"
        },
        "origin": {
          "$ref": "#/$defs/Origin"
        }
      },
      "required": [
        "type",
        "text"
      ]
    },
    "CompactionBlock": {
      "type": "object",
      "properties": {
        "type": {
          "const": "compaction"
        },
        "id": {
          "type": "string"
        },
        "cache": {
          "$ref": "#/$defs/CacheMark"
        },
        "vendor": {
          "$ref": "#/$defs/VendorMap"
        },
        "provider_executed": {
          "type": "boolean"
        },
        "vendor_state": {
          "description": "Opaque"
        },
        "text": {
          "type": "string"
        },
        "origin": {
          "$ref": "#/$defs/Origin"
        }
      },
      "required": [
        "type",
        "vendor_state",
        "origin"
      ]
    },
    "CustomBlock": {
      "type": "object",
      "properties": {
        "type": {
          "const": "custom"
        },
        "id": {
          "type": "string"
        },
        "cache": {
          "$ref": "#/$defs/CacheMark"
        },
        "vendor": {
          "$ref": "#/$defs/VendorMap"
        },
        "provider_executed": {
          "type": "boolean"
        },
        "kind": {
          "type": "string",
          "pattern": "^[a-z0-9_]+\\.[A-Za-z0-9_.-]+$",
          "description": "<vendor>.<type>"
        },
        "data": {},
        "origin": {
          "$ref": "#/$defs/Origin"
        }
      },
      "required": [
        "type",
        "kind"
      ]
    },
    "Block": {
      "oneOf": [
        {
          "$ref": "#/$defs/TextBlock"
        },
        {
          "$ref": "#/$defs/ImageBlock"
        },
        {
          "$ref": "#/$defs/DocumentBlock"
        },
        {
          "$ref": "#/$defs/ToolCallBlock"
        },
        {
          "$ref": "#/$defs/ToolResultBlock"
        },
        {
          "$ref": "#/$defs/ReasoningBlock"
        },
        {
          "$ref": "#/$defs/CompactionBlock"
        },
        {
          "$ref": "#/$defs/CustomBlock"
        }
      ],
      "discriminator": {
        "propertyName": "type"
      },
      "description": "Unknown types decode as CustomBlock"
    },
    "Message": {
      "type": "object",
      "properties": {
        "role": {
          "$ref": "#/$defs/Role"
        },
        "content": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Block"
          }
        }
      },
      "required": [
        "role",
        "content"
      ]
    },
    "ToolDef": {
      "type": "object",
      "properties": {
        "type": {
          "const": "function"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "input_schema": {
          "type": "object"
        },
        "strict": {
          "type": "boolean"
        },
        "cache": {
          "$ref": "#/$defs/CacheMark"
        },
        "vendor": {
          "$ref": "#/$defs/VendorMap"
        }
      },
      "required": [
        "type",
        "name",
        "description",
        "input_schema"
      ]
    },
    "ProviderTool": {
      "type": "object",
      "properties": {
        "type": {
          "const": "provider"
        },
        "provider_tool": {
          "type": "string",
          "pattern": "^[a-z0-9_]+\\.[A-Za-z0-9_.-]+$"
        },
        "config": {
          "type": "object"
        }
      },
      "required": [
        "type",
        "provider_tool"
      ],
      "description": "A tool the vendor runs itself; config is the vendor's own object"
    },
    "Tool": {
      "oneOf": [
        {
          "$ref": "#/$defs/ToolDef"
        },
        {
          "$ref": "#/$defs/ProviderTool"
        }
      ],
      "discriminator": {
        "propertyName": "type"
      }
    },
    "ReasoningLevel": {
      "anyOf": [
        {
          "enum": [
            "auto",
            "none",
            "minimal",
            "low",
            "medium",
            "high",
            "xhigh",
            "max"
          ]
        },
        {
          "type": "string"
        }
      ]
    },
    "ToolChoice": {
      "type": "object",
      "properties": {
        "mode": {
          "anyOf": [
            {
              "enum": [
                "auto",
                "none",
                "required",
                "named"
              ]
            },
            {
              "type": "string"
            }
          ]
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "mode"
      ],
      "description": "Canonical form; bindings accept the strings auto / none / required and {name} as sugar"
    },
    "OutputFormat": {
      "type": "object",
      "properties": {
        "json_schema": {
          "type": "object"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "json_schema"
      ]
    },
    "Timeout": {
      "type": "object",
      "properties": {
        "connect": {
          "type": "number"
        },
        "read": {
          "type": "number"
        },
        "total": {
          "type": "number"
        }
      },
      "description": "Seconds; bindings accept a plain number as total"
    },
    "Options": {
      "type": "object",
      "properties": {
        "max_output_tokens": {
          "type": "integer",
          "minimum": 1
        },
        "reasoning": {
          "$ref": "#/$defs/ReasoningLevel"
        },
        "reasoning_summary": {
          "anyOf": [
            {
              "enum": [
                "none",
                "auto"
              ]
            },
            {
              "type": "string"
            }
          ]
        },
        "tool_choice": {
          "$ref": "#/$defs/ToolChoice"
        },
        "parallel_tools": {
          "type": "boolean"
        },
        "output": {
          "$ref": "#/$defs/OutputFormat"
        },
        "stop_sequences": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "cache": {
          "anyOf": [
            {
              "enum": [
                "none",
                "auto",
                "explicit"
              ]
            },
            {
              "type": "string"
            }
          ]
        },
        "retries": {
          "type": "integer",
          "minimum": 0
        },
        "user_id": {
          "type": "string"
        }
      },
      "description": "Portable options; everything else goes through vendor"
    },
    "ChatRequest": {
      "type": "object",
      "properties": {
        "model": {
          "type": "string"
        },
        "messages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Message"
          },
          "minItems": 1
        },
        "system": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TextBlock"
          }
        },
        "tools": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Tool"
          }
        },
        "options": {
          "$ref": "#/$defs/Options"
        },
        "vendor": {
          "$ref": "#/$defs/VendorMap"
        },
        "timeout": {
          "$ref": "#/$defs/Timeout"
        },
        "headers": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "strict": {
          "type": "boolean"
        },
        "include_raw": {
          "type": "boolean"
        }
      },
      "required": [
        "model",
        "messages"
      ]
    },
    "StopReason": {
      "anyOf": [
        {
          "enum": [
            "complete",
            "tool_call",
            "max_output_tokens",
            "stop_sequence",
            "context_window_exceeded",
            "refusal",
            "content_filtered",
            "continue_required",
            "compaction",
            "malformed_output",
            "other"
          ]
        },
        {
          "type": "string"
        }
      ]
    },
    "Stop": {
      "type": "object",
      "properties": {
        "reason": {
          "$ref": "#/$defs/StopReason"
        },
        "raw": {
          "description": "Vendor's own value"
        }
      },
      "required": [
        "reason"
      ]
    },
    "Usage": {
      "type": "object",
      "properties": {
        "input": {
          "type": "object",
          "properties": {
            "total": {
              "type": "integer"
            },
            "cache_read": {
              "type": "integer"
            },
            "cache_write": {
              "type": "integer"
            }
          },
          "required": [
            "total"
          ],
          "description": "total includes cached tokens"
        },
        "output": {
          "type": "object",
          "properties": {
            "total": {
              "type": "integer"
            },
            "reasoning": {
              "type": "integer"
            }
          },
          "required": [
            "total"
          ]
        },
        "raw": {}
      },
      "required": [
        "input",
        "output"
      ]
    },
    "Warning": {
      "type": "object",
      "properties": {
        "kind": {
          "anyOf": [
            {
              "enum": [
                "unsupported",
                "compatibility",
                "deprecated"
              ]
            },
            {
              "type": "string"
            }
          ]
        },
        "feature": {
          "type": "string"
        },
        "detail": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "feature"
      ]
    },
    "Response": {
      "type": "object",
      "properties": {
        "content": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Block"
          }
        },
        "stop": {
          "$ref": "#/$defs/Stop"
        },
        "usage": {
          "anyOf": [
            {
              "$ref": "#/$defs/Usage"
            },
            {
              "type": "null"
            }
          ]
        },
        "warnings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Warning"
          }
        },
        "origin": {
          "$ref": "#/$defs/Origin"
        },
        "latency_ms": {
          "type": "number"
        },
        "first_token_ms": {
          "type": "number"
        },
        "raw": {
          "description": "Vendor reply body; only with include_raw"
        }
      },
      "required": [
        "content",
        "stop",
        "usage",
        "warnings",
        "origin",
        "latency_ms"
      ]
    },
    "BlockKind": {
      "anyOf": [
        {
          "enum": [
            "text",
            "reasoning",
            "tool_call",
            "compaction",
            "custom"
          ]
        },
        {
          "type": "string"
        }
      ]
    },
    "Event": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "block_start"
            },
            "parent_id": {
              "type": "string",
              "description": "Reserved for agents"
            },
            "index": {
              "type": "integer"
            },
            "kind": {
              "$ref": "#/$defs/BlockKind"
            },
            "id": {
              "type": "string"
            },
            "name": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "index",
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "text_delta"
            },
            "parent_id": {
              "type": "string",
              "description": "Reserved for agents"
            },
            "index": {
              "type": "integer"
            },
            "text": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "index",
            "text"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "reasoning_delta"
            },
            "parent_id": {
              "type": "string",
              "description": "Reserved for agents"
            },
            "index": {
              "type": "integer"
            },
            "text": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "index",
            "text"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "tool_call_delta"
            },
            "parent_id": {
              "type": "string",
              "description": "Reserved for agents"
            },
            "index": {
              "type": "integer"
            },
            "arguments_json": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "index",
            "arguments_json"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "block_stop"
            },
            "parent_id": {
              "type": "string",
              "description": "Reserved for agents"
            },
            "index": {
              "type": "integer"
            },
            "block": {
              "$ref": "#/$defs/Block"
            }
          },
          "required": [
            "type",
            "index",
            "block"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "finish"
            },
            "parent_id": {
              "type": "string",
              "description": "Reserved for agents"
            },
            "response": {
              "$ref": "#/$defs/Response"
            }
          },
          "required": [
            "type",
            "response"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "raw"
            },
            "parent_id": {
              "type": "string",
              "description": "Reserved for agents"
            },
            "event": {}
          },
          "required": [
            "type",
            "event"
          ]
        }
      ],
      "discriminator": {
        "propertyName": "type"
      },
      "description": "Unknown event types are delivered as raw"
    },
    "ErrorKind": {
      "anyOf": [
        {
          "enum": [
            "auth",
            "rate_limit",
            "quota",
            "server",
            "connection",
            "timeout",
            "cancelled",
            "not_found",
            "context_overflow",
            "request_too_large",
            "bad_request",
            "malformed_response",
            "unsupported"
          ]
        },
        {
          "type": "string"
        }
      ]
    },
    "ProviderError": {
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/$defs/ErrorKind"
        },
        "message": {
          "type": "string"
        },
        "status": {
          "type": "integer"
        },
        "code": {
          "type": "string"
        },
        "retryable": {
          "type": "boolean"
        },
        "retry_after": {
          "type": "number"
        },
        "attempts": {
          "type": "integer"
        },
        "body": {
          "description": "Redacted vendor error body"
        },
        "request_id": {
          "type": "string"
        },
        "origin": {
          "$ref": "#/$defs/Origin"
        }
      },
      "required": [
        "kind",
        "message",
        "retryable",
        "attempts"
      ]
    },
    "EmbedRequest": {
      "type": "object",
      "properties": {
        "model": {
          "type": "string"
        },
        "input": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "options": {
          "type": "object",
          "properties": {
            "dimensions": {
              "type": "integer",
              "minimum": 1
            },
            "retries": {
              "type": "integer",
              "minimum": 0
